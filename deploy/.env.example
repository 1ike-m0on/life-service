MYSQL_ALLOW_EMPTY_PASSWORD=no
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=life_service
MYSQL_PORT=3307
MYSQL_MEM_LIMIT=768m
MYSQL_MEMSWAP_LIMIT=768m
MYSQL_CPUS=1.0
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
MYSQL_MAX_CONNECTIONS=80
MYSQL_PERFORMANCE_SCHEMA=OFF

REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MEM_LIMIT=256m
REDIS_MEMSWAP_LIMIT=256m
REDIS_CPUS=0.5
REDIS_MAXMEMORY=128mb

ROCKETMQ_VERSION=5.5.0
ROCKETMQ_BROKER_IP=127.0.0.1
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_DASHBOARD_PORT=18082
ROCKETMQ_NAMESRV_MEM_LIMIT=384m
ROCKETMQ_NAMESRV_MEMSWAP_LIMIT=384m
ROCKETMQ_NAMESRV_CPUS=0.5
ROCKETMQ_NAMESRV_JAVA_OPT_EXT=-server -Xms192m -Xmx192m -Xmn96m
ROCKETMQ_BROKER_MEM_LIMIT=1024m
ROCKETMQ_BROKER_MEMSWAP_LIMIT=1024m
ROCKETMQ_BROKER_CPUS=1.0
ROCKETMQ_BROKER_JAVA_OPT_EXT=-server -Xms512m -Xmx512m -Xmn256m
ROCKETMQ_DASHBOARD_MEM_LIMIT=512m
ROCKETMQ_DASHBOARD_MEMSWAP_LIMIT=512m
ROCKETMQ_DASHBOARD_CPUS=0.5
ROCKETMQ_DASHBOARD_JAVA_OPTS=-Xms256m -Xmx256m -Drocketmq.namesrv.addr=rocketmq-namesrv:9876

FLASH_SALE_STARTUP_WARMUP_ENABLED=true
FLASH_SALE_STARTUP_WARMUP_FAIL_FAST=false
FLASH_SALE_STARTUP_WARMUP_MAX_VOUCHERS=200

ORDER_MESSAGE_PROVIDER=rocketmq
ORDER_CLOSE_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_GLOBAL_LIMIT_OVERRIDE=0

PROMETHEUS_VERSION=v2.54.1
PROMETHEUS_PORT=9090
PROMETHEUS_MEM_LIMIT=256m
PROMETHEUS_MEMSWAP_LIMIT=256m
PROMETHEUS_CPUS=0.25
PROMETHEUS_RETENTION_TIME=7d

GRAFANA_VERSION=11.2.2
GRAFANA_PORT=3000
GRAFANA_MEM_LIMIT=256m
GRAFANA_MEMSWAP_LIMIT=256m
GRAFANA_CPUS=0.25
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
